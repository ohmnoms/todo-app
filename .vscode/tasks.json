{
  "version": "2.0.0",
  "tasks": [
    {
      // Build the .NET API
      "label": "build-api",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/backend/Todo.Api/Todo.Api.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      // Run Vue dev server
      "label": "npm run dev",
      "type": "npm",
      "script": "dev",
      "path": "frontend/todo-app",
      "group": "build",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": [
          {
            "regexp": ".",
            "file": 0,
            "location": 1,
            "message": 2
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Local:",
          "endsPattern": "ready in"
        }
      }
    }
  ]
}
